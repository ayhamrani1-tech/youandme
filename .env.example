# ---------------------------------------------------------------------------
# you&me — copy to .env and adjust. Everything here has a working default
# except the JWT secrets, which are required in production.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database --------------------------------------------------------------
# sqlite (zero setup, the default) or postgres
DB_DRIVER=sqlite
SQLITE_FILE=server/data/youandme.db
# DB_DRIVER=postgres
# DATABASE_URL=postgres://youandme:youandme@localhost:5432/youandme
DB_POOL_SIZE=6
# DB_LOG=true

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production unless both are set.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d
JWT_ISSUER=youandme

# --- Web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
# Set false to run the API alone and serve the client elsewhere.
SERVE_WEB=true

# --- Platform rules --------------------------------------------------------
FIELD_REQUIRED_PLAYERS=14
FIELD_SLOT_MINUTES=90
POINTS_EXPIRY_MONTHS=6
DESCRIPTION_WORD_LIMIT=200
CANCELLATION_WINDOW_HOURS=3
CURRENCY=JOD

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=12

# --- Seed accounts ---------------------------------------------------------
SEED_ADMIN_EMAIL=admin@youandme.jo
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEFAULT_PASSWORD=Passw0rd!
